# Cloudflare Turnstile（可选）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Provider 配置加密主密钥（生产环境请使用 wrangler secret put）
PROVIDER_CREDENTIAL_KEY=

# 首次登录后台时自动创建管理员；创建后可移除这两个变量
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# SMTP 也可由后台配置；以下环境变量作为回退配置
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_AUTH_TYPE=plain
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@zhiyin.us.ci
SMTP_FROM_NAME=知音
SMTP_REPLY_TO=
